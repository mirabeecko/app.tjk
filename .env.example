# AIRBAG PWA — konfigurace (zkopírujte jako .env a doplňte hodnoty)
# Server čte .env automaticky (dotenv). Vše je volitelné.

# Port HTTP serveru (výchozí 4310)
# PORT=4310

# ── Databáze ─────────────────────────────────────────────────────
# sqlite   (výchozí) — lokální vývoj a testy (soubor data/airbag.db)
# postgres — produkce (Supabase/Postgres, schéma `app`)
DB_DRIVER=sqlite
# Povinné pro DB_DRIVER=postgres — Supabase pooler connection string:
#   postgresql://postgres.<ref>:<heslo>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# (Schéma `app` se aplikuje z supabase/schema-app.sql v SQL editoru.)
DATABASE_URL=
# Demo role účty (dozor@/vybor@airbag.test) se zakládají jen když NENÍ false.
# Produkce: SEED_DEMO=false (vlastník/superadmin se vytvoří vždy).
# SEED_DEMO=false

# ── Reálné odesílání e-mailů (SMTP) ──────────────────────────────
# Pokud jsou vyplněné SMTP_HOST + SMTP_USER + SMTP_PASS, přihlašovací
# a jiné e-maily se REÁLNĚ odesílají. Bez nich běží STUB režim:
# zprávy jsou vidět jen v dev inboxu na /#/outbox (a v konzoli).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Odesílatel (zobrazované jméno + adresa)
SMTP_FROM=Tělovýchovná jednota Krupka <noreply@krupka.example>

# ── Synchronizace se Supabase členskou evidencí (public.members) ────
# Stejný Supabase projekt jako WebDo24: https://mljqltwcdqknezuqpisb.supabase.co
# Tabulka members = existující evidence TJ Krupka (import z IS ČUS).
# SUPABASE_SYNC: off (vypnuto) | dry-run (jen loguje, nic nezapíše) | on (reálný upsert)
# Service role key se používá jen serverově, nikdy se neloguje ani nevrací.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SYNC=off

# ── Stripe platební brána (Stripe Checkout) ─────────────────────────
# Bez klíče běží TEST MODE (žádná reálná platba, simulace v aplikaci).
#   Test klíč: sk_test_...  → https://dashboard.stripe.com/test/apikeys
#   Live klíč: sk_live_...  → teprve až budete přijímat reálné platby
# Webhook secret (whsec_...) najdete u webhook endpointu:
#   URL:      POST https://<host>/api/payments/webhook
#   Událost:  checkout.session.completed
# Lokální vývoj: `stripe listen --forward-to localhost:4310/api/payments/webhook`
# (testovací karta pro test režim: 4242 4242 4242 4242)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
